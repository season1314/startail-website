<div id='subpage' class="subpage">
    <div class="page-view">
        <div class='card'>
            <div class='card-header d-flex justify-content-between align-items-center'>
                <div class='header-left'>
                    <strong id="subpage-title"></strong>
                </div>
                <div class='header-right'>
                    <button type='button' class='btn btn-danger btn-sm' id='subpage-closeBtn'>&times;</button>
                </div>
            </div>
            <!-- create -->
            <div id="subpage-create">
                <div class='card-body card-block'
                    style='width:50vw;max-height:80vh;min-height 50vh;padding-left:50px;padding-right:50px;overflow:auto'>
                    <form action='#' method='post' enctype='multipart/form-data' class='form-horizontal'>
                        <div class='row form-group' id="create">
                            <div class='col col-md-3'><label for='text-input' class='form-control-label'>name<span
                                        style="color:red">*</span></label>
                            </div>
                            <div class='col-12 col-md-9'><input type='text' id='create-name' placeholder='name'
                                    class='form-control' name="name" autocomplete="name" /><small
                                    class="help-block form-text color-red" style="height:12px"></small></div>
                        </div>
                        <div class='row form-group'>
                            <div class='col col-md-3'><label for='text-input' class='form-control-label'>type</label>
                            </div>
                            <div class='col-12 col-md-9'><input type='text' id='create-type' name='text-input'
                                    placeholder='type' class='form-control' /><small
                                    class="help-block form-text color-red" style="height:12px"></small>
                            </div>
                        </div>
                    </form>
                </div>
                <div class='card-footer' id='subpage-create'>
                    <button type='submit' class='btn btn-primary btn-sm' id='subpage-create-submit'>
                        <i class='fa fa-dot-circle-o'></i>
                        Submit
                    </button>
                    <button type='reset' class='btn btn-danger btn-sm'>
                        <i class='fa fa-ban'></i>
                        Reset
                    </button>
                </div>
            </div>
            <!-- create end -->

            <!-- edit -->
            <div id="subpage-edit">
                <div class='card-body card-block'
                    style='width:50vw;max-height:80vh;padding-left:50px;padding-right:50px;overflow:auto'>
                    <form action='#' method='post' enctype='multipart/form-data' class='form-horizontal'>
                        <div class="row form-group" id="edit">
                            <div class="col col-md-3"><label class=" form-control-label">name</label></div>
                            <div class="col-12 col-md-9">
                                <input type='text' id='edit-name' name='text-input' placeholder='name'
                                    class='form-control' /><small class="help-block form-text color-red"
                                    style="height:12px"></small>
                            </div>
                        </div>
                        <div class='row form-group'>
                            <div class='col col-md-3'><label for='text-input' class='form-control-label'>type</label>
                            </div>
                            <div class='col-12 col-md-9'><input type='text' id='edit-type' name='text-input'
                                    placeholder='type' class='form-control' /><small
                                    class="help-block form-text color-red" style="height:12px"></small>
                            </div>
                        </div>
                    </form>
                </div>
                <div class='card-footer' id='subpage-create'>
                    <button type='submit' class='btn btn-primary btn-sm' id='subpage-edit-submit'>
                        <i class='fa fa-dot-circle-o'></i>
                        Submit
                    </button>
                    <button type='reset' class='btn btn-danger btn-sm'>
                        <i class='fa fa-ban'></i>
                        Reset
                    </button>
                </div>
            </div>
            <!-- edit end -->
        </div>
    </div>
</div>
</div>

<script>
    $(document).on('focus', 'input', function () {
        const $small = $(this).next('small');
        $small.text('');
    })

    const subpageError = (messages, type) => {
        Object.entries(messages).forEach(([key, value]) => {
            const dom = $('#' + type + '-' + key)
            if (dom) dom.next('small').text(value[0])
        });
    }
</script>