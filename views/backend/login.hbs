<!doctype html>
<html lang="en">

<head>
  {{> backend/head title=title}}
  <link rel="stylesheet" href="/backend/css/spinner.css">
</head>

<body class="bg-light">
  {{> backend/infobar}}
  <div class="sufee-login d-flex align-content-center flex-wrap">
    <div class="container">
      <div class="login-content">
        <div class="login-form">
          <div class="text-center" style="margin-bottom:20px">
            <label class="fw-bold text-secondary" style="font-size:32px;letter-spacing:2px;">
              ADMIN SYSTEM LOGIN
            </label>
          </div>
          <form>
            <div class="form-group">
              <label>Username</label>
              <input type="text" class="form-control" placeholder="Username" id="username">
              <small class="help-block form-text color-red" style="height:12px"></small>
            </div>
            <div class="form-group">
              <label>Password</label>
              <input type="password" class="form-control" placeholder="Password" id="password">
              <small class="help-block form-text color-red" style="height:12px"></small>
            </div>
            <button type="submit" class="btn btn-success btn-flat m-b-30 m-t-30" id="submit" style="margin-top:20px">
              <span class="btn-text">Sign in</span>
              <span class="spinner"></span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
{{> backend/script }}
<script>
  jQuery(function ($) {

    //Handle submit
    $('form').on('submit', async function (event) {
      event.preventDefault();

      if ($('#submit').prop('disabled')) return

      $('#submit').addClass('loading').prop('disabled', true)

      const username = $('#username').val();
      const password = $('#password').val();

      const result = await fetchData('/admin/login', 'POST', { username, password });
      console.log(result)
      if (result.code == 2) {
        Object.entries(result.messages).forEach(([key, value]) => {
          $('#' + key).next('small').text(value[0])
        });
      } else if (result.code == 0) {
        window.location.href = "/admin"
      } else {
        showInfo('danger', result.messages)
      }

      $('#submit').removeClass('loading').prop('disabled', false)

    });


    //Clear error info
    $('input').focus(function () {
      const $small = $(this).next('small');
      $small.text('');
    });
  });
</script>
<style>
</style>

</html>