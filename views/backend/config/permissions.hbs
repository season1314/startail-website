<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}
    {{> backend/permissions}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->


        <!-- Content -->
        <div class="content" style="min-height:calc(100vh - 240px)">
            <div class="animated fadeIn">
                <div class="row">
                    <div style="width:100%">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">Permission List</strong>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px;height:80px;margin-bottom:0 !important">
                                <!-- 左边搜索框 -->
                                <div class="d-flex align-items-center">
                                    <input type="text" id="search-input" class="form-control form-control-sm me-2"
                                        placeholder="Permission Name" style="width:180px">
                                    <button id="btn-search" class="btn btn-primary btn-sm"
                                        style="margin-left:10px;">Search</button>
                                    <button id="btn-reset" class="btn btn-secondary btn-sm"
                                        style="margin-left:10px;">Reset</button>
                                </div>
                                <!-- 右边新增按钮 -->
                                <button id="btn-add" class="btn btn-success btn-sm">New</button>
                            </div>

                            <div class="card-body" style="padding-top:0">
                                <div class="table-responsive">
                                    <table id="bootstrap-data-table" class="table table-striped" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Permission Name</th>
                                                <th>Url</th>
                                                <th>Method</th>
                                                <th>Des</th>
                                                <th>CreateBy</th>
                                                <th>CreateAt</th>
                                                <th>Opt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- /.content -->
        <div class="clearfix"></div>
        <!-- Footer -->
        <!-- /.site-footer -->
    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>
    <script src="/backend/js/bootstrap-table.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        let _data;
        $(document).ready(function () {
            //Init table by bootstrap-table.js
            const columns = [
                { data: "name" },
                { data: "url" },
                { data: "method" },
                { data: "des" },
                { data: "createdBy" },
                { data: "createdAt" },
                {
                    data: null,
                    render: function (data, type, row) {
                        const itemStr = JSON.stringify(row).replace(/"/g, '&quot;');
                        return `<button class="btn btn-sm btn-primary btn-edit" data-item="${itemStr}">Edit</button>
                        <button class="btn btn-sm btn-danger btn-delete" data-item="${row._id}">Delete</button>`;
                    }
                }
            ];

            const table = initDataTable('#bootstrap-data-table', '/admin/config/permissions/list', columns);


            //Create
            $('#btn-add').on('click', function (event) {
                event.preventDefault();
                $('#subpage-title').text('Create New');
                $('#subpage-create').show();
                $('#subpage-edit').hide();
                $('#subpage').show();
            })

            $('#subpage-create-submit').on('click', async function (event) {
                event.preventDefault();
                const name = $('#create-name').val();
                const url = $('#create-url').val();
                const method = $('#create-method input[type="radio"]:checked').val();
                const des = $('#create-des').val();
                const result = await fetchData('/admin/config/permissions', 'POST', {
                    name,
                    url,
                    method,
                    des,
                });
                if (result.code == 2) {
                    subpageError(result.messages, 'create')
                } else if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else {
                    showInfo('success', result.messages)
                    $('#subpage')
                        .find('input:not([type="radio"])').val('')
                        .end()
                        .find('input[type="radio"]')
                        .prop('checked', false)
                        .end()
                        .find('small')
                        .text('')
                        .end()
                        .hide();
                    table.ajax.reload()
                }
            })

            $('#subpage-create-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                $('#subpage').find('input:not([type="radio"])').val('').find('input[type="radio"]')
                    .prop('checked', false)
                    .end()
                    .find('small')
                    .text('')
                    .end()
            });

            //Edit
            $('#bootstrap-data-table').on('click', '.btn-edit', function () {
                const item = JSON.parse($(this).attr('data-item'));
                _data = item
                Object.entries(_data).forEach(([key, value]) => {
                    if (key == '_id') $('#edit-id').data('id', value).text(value);
                    const dom = $('#edit-' + key)
                    if (!dom) return
                    dom.prop('tagName') == 'P' ? dom.text(value) : dom.val(value)
                })
                $('#subpage-title').text('Edit Info');
                $('#subpage-create').hide();
                $('#subpage-edit').show();
                $('#subpage').show();
            });


            $('#subpage-edit-submit').on('click', async function (event) {
                event.preventDefault();
                const id = $('#edit-id').data('id');
                const name = $('#edit-name').val();
                const des = $('#edit-des').val();
                const result = await fetchData('/admin/config/permissions', 'PUT', {
                    id,
                    name,
                    des,
                })
                if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else if (result.code == 2) {
                    subpageError(result.messages, 'edit')
                } else {
                    showInfo('success', result.messages)
                    $('#subpage').find('input').val('').end().find('small').text('').end().hide();
                    table.ajax.reload(null, false)
                }
            })

            $('#subpage-edit-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                Object.entries(_data).forEach(([key, value]) => {
                    if (key == '_id') $('#edit-id').data('id', value).val(value);
                    const dom = $('#edit-' + key)
                    if (!dom) return
                    dom.prop('tagName') == 'P' ? dom.text(value) : dom.val(value)
                })
            });

            //Delete
            $('#bootstrap-data-table').on('click', '.btn-delete', function () {
                const id = $(this).attr('data-item');
                openConfirm({
                    title: 'Confirm Delete',
                    context: 'Deleting this permission may result in users being unable to access this functionality.',
                    onConfirm: async () => {
                        loading().show()
                        const result = await fetchData('/admin/config/permissions', 'DELETE', {
                            id,
                        })
                        if (result.code !== 0) {
                            showInfo('danger', result.messages)
                        } else {
                            showInfo('success', result.messages)
                            table.ajax.reload()
                        }
                        loading().hide()
                    }
                })
            });
        });
    </script>
</body>
</html>