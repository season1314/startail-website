<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->


        <!-- Content -->
        <div class="content">
            <div class="animated fadeIn">
                <div class="row">
                    <div style="width:100%">
                        <div class="card">
                            <div class="card-header">
                                <strong>Categories</strong>
                                <button class="btn btn-success btn-sm" style="float:right" id="new-button">
                                    New
                                </button>
                            </div>
                            <div class="card-body card-block">
                                <div class="form-class">
                                </div>
                            </div>
                            <div class="card-footer">
                                <button class="btn btn-primary btn-sm" id="submit">
                                    <i class="fa fa-dot-circle-o"></i> Save
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- /.content -->
        <div class="clearfix"></div>
        <!-- Footer -->
        {{> backend/footer}}
        <!-- /.site-footer -->
    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>
    <script src="/backend/js/init/datatables-init.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        window.addEventListener('DOMContentLoaded', async () => {
            //Init data
            fetchList()
        });
        //FetchData
        async function fetchList(page) {
            const getData = await fetchData('/admin/config/config', 'GET', { key: "categories" });
            if (getData.code == 0 && getData.data.property) {
                const html = getData.data.property.map(item => {
                    const itemStr = JSON.stringify(item);
                    return `<div class="form-group" style="padding:0 10px">
                        <textarea placeholder="Enter data" class="form-control" style="width:200px; height:200px;"> ${itemStr}</textarea></div>`
                }).join('')
                $('.form-class').html(html);
            }

        }

        //Handle save
        $(document).on('click', '#submit', async () => {
            event.preventDefault();
            try {
                let array = $('.form-class textarea').map(function () {
                    const data = $(this).val()
                    if (!data) return;
                    return JSON.parse(data)
                }).get();
                const update = await fetchData('/admin/config/config', 'POST', { key: 'categories', property: array, name: 'categories' })
                if (update.code == 0) {
                    showInfo('success', update.messages)
                    fetchList()
                } else {
                    showInfo('danger', update.messages)
                }
            } catch (err) {
                showInfo('danger', 'JSON format is error')
            }
        })

        //Handle new
        $(document).on('click','#new-button',()=>{
            event.preventDefault();
            const content = `<div class="form-group" style="padding:0 10px">
                        <textarea placeholder="Enter data" class="form-control" style="width:200px; height:200px;"></textarea></div>`
            $('.form-class').append(content)
        })


    </script>
</body>
<style>
    .form-class {
        display: flex;
        width: 100%;
        flex-direction: row;
        flex-wrap: wrap;
        height: calc(100vh - 480px);
        overflow-y: auto;
    }
</style>

</html>