<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
    <link rel="stylesheet" href="/backend/css/spinner.css">
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}
    {{> backend/detail}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->
        <!-- Content -->
        <div class="content" style="min-height:calc(100vh - 240px)">
            <div class="animated fadeIn">
                <div class="row">
                    <!-- en -->
                    <div style="width:100%">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">Article</strong>
                                <button class="btn btn-success btn-sm" style="float:right" id="submit">
                                    Save
                                </button>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px">
                            </div>
                            <div class="card-body" style="padding-top: 0">
                                <form class='form-horizontal'>
                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>name<span style="color:red">*</span></label>
                                        </div>
                                        <div class='col-12 col-md-9'><input type='text' id='name-en'
                                                placeholder='article name' class='form-control' name="name"
                                                autocomplete="name" value="{{name.en}}" /><small
                                                class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>
                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>introduction<span
                                                    style="color:red">*</span></label>
                                        </div>
                                        <div class='col-12 col-md-9'> <textarea class="form-control"
                                                id="introduction-en" rows="3"
                                                placeholder="article description...">{{introduction.en}}</textarea>
                                            <small class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>categories<span
                                                    style="color:red">*</span></label>
                                        </div>
                                        <div class='col-12 col-md-9'>
                                            <div id="categories-en">
                                                {{#each categories}}
                                                <div class="form-check form-check-inline">
                                                    {{#each this}}
                                                    <input class="form-check-input" type="checkbox" value="{{@key}}"
                                                        {{#if this}}checked{{/if}} />
                                                    <label class="form-check-label">{{@key}}</label>{{/each}}
                                                </div>{{/each}}
                                            </div>
                                            <small class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>cover image<span
                                                    style="color:red">*</span></label>
                                        </div>
                                        <div class="mb-3">
                                            <div class='col-12 col-md-9' style="max-width:none" id="cover-image">
                                                {{#if coverImg}}
                                                <div style="display:flex;width:100%">
                                                    <div class="coverImgDiv" id="cover-image-en"
                                                        style="background-image:url({{coverUrl}})"
                                                        data-path="{{coverImg}}">
                                                    </div>
                                                    <div class="coverImgOpt" id="cover-image-delete">
                                                        <i class="menu-icon fa fa-trash-o"></i>
                                                    </div>
                                                </div>
                                                {{else}}
                                                <div id="cover-image-add">
                                                    <i class="fa fa-plus-square"></i>
                                                </div>
                                                {{/if}}
                                            </div>
                                            <small class="help-block form-text color-red"
                                                style="height:12px;margin-left:15px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>content image<span
                                                    style="color:red">*</span></label>
                                        </div>
                                        <div class="mb-3">
                                            <div class='col-12 col-md-9' style="max-width:none" id="content-image">
                                                {{#if contentImg}}
                                                <div style="display:flex;width:100%">
                                                    <div class="coverImgDiv" id="content-image-en"
                                                        style="background-image:url({{contentUrl}})"
                                                        data-path="{{contentImg}}">
                                                    </div>
                                                    <div class="coverImgOpt" id="content-image-delete">
                                                        <i class="menu-icon fa fa-trash-o"></i>
                                                    </div>
                                                </div>
                                                {{else}}
                                                <div id="content-image-add">
                                                    <i class="fa fa-plus-square"></i>
                                                </div>
                                                {{/if}}
                                            </div>
                                            <small class="help-block form-text color-red"
                                                style="height:12px;margin-left:15px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group' id="tags-en">
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>tags</label>
                                        </div>
                                        <div class='col-12 col-md-9'>
                                            <div class="mainTags">
                                                {{#each matchedTags}}
                                                <span class="badge badge-info" id="{{this._id}}"
                                                    style="margin-right:5px">{{this.name}}</span>
                                                {{/each}}
                                                <span id="tags-add">
                                                    <i class="fa  fa-gear"></i>
                                                </span>
                                            </div>
                                            <small class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>


                                    <div class='row form-group' id="downloads-en">
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>downloads</label>
                                        </div>
                                        <div class='col-12 col-md-9'>
                                            <div>
                                                <div class="mainDownloads">
                                                    <span data-lang="en" class="downloads-add">
                                                        {{#each downloads.en}}
                                                        <span class="badge badge-info" data-path="{{this.des}}"
                                                            style="margin-right:5px">{{this.des}}</span>
                                                        {{/each}}
                                                        <i class="fa  fa-gear"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <small class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group' id="guides-en">
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>guides</label>
                                        </div>
                                        <div class='col-12 col-md-9'>
                                            <div>
                                                <div class="mainGuides">
                                                    <span data-lang="en" class="guides-add">
                                                        {{#each guides.en}}
                                                        <span class="badge badge-info" data-path="{{this.des}}"
                                                            style="margin-right:5px">{{this.des}}</span>
                                                        {{/each}}
                                                        <i class="fa  fa-gear"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <small class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>operation
                                                system</label>
                                        </div>
                                        <div class='col-12 col-md-9'>
                                            <div id="os-en">{{#each os}}
                                                <div class="form-check form-check-inline">
                                                    {{#each this}}
                                                    <input class="form-check-input" type="checkbox" value="{{@key}}"
                                                        {{#if this}}checked{{/if}} />
                                                    <label class="form-check-label">{{@key}}</label>{{/each}}
                                                </div>{{/each}}
                                                <small class="help-block form-text color-red"
                                                    style="height:12px"></small>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                                <input type="file" id="cover-images-file" style="display:none" accept="image/*"
                                    data-item="cover-image" />
                                <input type="file" id="content-images-file" style="display:none" accept="image/*"
                                    data-item="content-image" />
                            </div>
                        </div>
                    </div>
                    <!-- other lang -->
                    {{#each configLang}}
                    {{#if (neq this "en")}}
                    <div style="width:100%">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">{{this}}</strong>
                                <a style="float:right;height:31px"></a>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px">
                            </div>
                            <div class="card-body" style="padding-top: 0">
                                <form class='form-horizontal'>
                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>name</label>
                                        </div>
                                        <div class='col-12 col-md-9'><input type='text' id='name-{{this}}'
                                                placeholder='article name' class='form-control' name="name"
                                                autocomplete="name" value="{{lookup ../name this}}" /><small
                                                class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>
                                    <div class='row form-group'>
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>introduction</label>
                                        </div>
                                        <div class='col-12 col-md-9'> <textarea class="form-control"
                                                id="introduction-{{this}}" rows="3"
                                                placeholder="article description...">{{lookup ../introduction this}}</textarea><small
                                                class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group' id="downloads-{{this}}">
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>downloads</label>
                                        </div>
                                        <div class='col-12 col-md-9'>
                                            <div>
                                                <div class="mainDownloads">
                                                    {{#each (lookup ../downloads this)}}
                                                    <span class="badge badge-info" data-path="{{this.path}}"
                                                        style="margin-right:5px">{{this.des}}</span>
                                                    {{/each}}
                                                    <span data-lang="{{this}}" class="downloads-add">
                                                        <i class="fa  fa-gear"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <small class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>

                                    <div class='row form-group' id="guides-{{this}}">
                                        <div class='col col-md-3'><label for='text-input'
                                                class='form-control-label'>guides</label>
                                        </div>
                                        <div class='col-12 col-md-9'>
                                            <div>
                                                <div class="mainGuides">
                                                    {{#each (lookup ../guides this)}}
                                                    <span class="badge badge-info" data-path="{{this.path}}"
                                                        style="margin-right:5px">{{this.des}}</span>
                                                    {{/each}}
                                                    <span data-lang="{{this}}" class="guides-add">
                                                        <i class="fa  fa-gear"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <small class="help-block form-text color-red" style="height:12px"></small>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                    {{/each}}
                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- Content -->


        <!-- /.content -->
        <div class="clearfix"></div>
        <!-- Footer -->
        {{> backend/footer}}
        <!-- /.site-footer -->
    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        let id = "{{articleId}}" || 0
        let TagsPage = 1
        let currentLang
        let Tags = {{{ tojson tags }}} || [];
        let TagsKey = ""
        let ConfigLang = {{ tojson configLang }}
        let Downloads = {{ tojson downloads }}
        let Guides = {{ tojson guides }}
        let title = {{ tojson name }}
        let introduction = {{ tojson introduction }}
        $(document).on('focus', 'input,textarea', function () {
            const $small = $(this).next('small');
            $small.text('');
        })

        $(document).on('change', '#categories-en input[type="checkbox"]', function () {
            $('#categories-en').next('small').text('');
        });

        $(document).ready(function () {
            $('#subpage-selected').text(Tags.length);

            //cover-image
            $('#cover-image').on('click', '#cover-image-add', function (event) {
                event.preventDefault();
                $('#cover-image').next('small').text('')
                $('#cover-images-file').click();
            })

            $('#cover-image').on('click', '#cover-image-delete', function (event) {
                event.preventDefault();
                const content = `<div id="cover-image-add"><i class="fa fa-plus-square"></i></div>`
                $('#cover-images-file').val('');
                $('#cover-image').find('div').remove().end().prepend(content).end();
            });

            $('#cover-image').on('click', '.coverImgDiv', function (event) {
                event.preventDefault();
                let backgroundImageUrl = $(this).css('background-image');
                backgroundImageUrl = backgroundImageUrl.replace(/^url\(["']?/, '').replace(/["']?\)$/, '');
                window.open(backgroundImageUrl, '_blank');
            })


            //content-image
            $('#content-image').on('click', '#content-image-add', function (event) {
                event.preventDefault();
                $('#content-image').next('small').text('')
                $('#content-images-file').click();
            })


            $('#content-image').on('click', '#content-image-delete', function (event) {
                event.preventDefault();
                const content = `<div id="content-image-add"><i class="fa fa-plus-square"></i></div>`
                $('#content-images-file').val('');
                $('#content-image').find('div').remove().end().prepend(content).end();
            });

            $('#content-image').on('click', '.coverImgDiv', function (event) {
                event.preventDefault();
                let backgroundImageUrl = $(this).css('background-image');
                backgroundImageUrl = backgroundImageUrl.replace(/^url\(["']?/, '').replace(/["']?\)$/, '');
                window.open(backgroundImageUrl, '_blank');
            })


            //tags
            $('#tags-en').on('click', '#tags-add', async function (event) {
                event.preventDefault();
                fetchTags({ page: TagsPage });
                $('#subpage-name').text('Tags');
                $('#subpage-downloads').hide()
                $('#subpage-tags').show();
                $('#subpage-guides').hide();
                $('#subpage').show();
                document.body.style.overflow = 'hidden';
            })

            $('#subpage-tags').find('#operation').find('button').eq(0).on('click', async function (event) {
                event.preventDefault();
                TagsKey = $('#subpage-tags').find('#operation').find('input').eq(0).val()
                TagsPage = 1
                fetchTags({ page: TagsPage, keyword: TagsKey });
            })

            $('#subpage-tags').find('#operation').find('button').eq(1).on('click', async function (event) {
                event.preventDefault();
                $('#subpage-tags').find('#operation').find('input').eq(0).val('')
                TagsKey = ''
                TagsPage = 1
                fetchTags({ page: TagsPage, keyword: TagsKey });
            })

            $('#subpage-tags').find('.subpagePagination').find('button').eq(0).on('click', async function (event) {
                event.preventDefault();
                TagsPage = TagsPage - 1
                fetchTags({ page: TagsPage, keyword: TagsKey });
            })

            $('#subpage-tags').find('.subpagePagination').find('button').eq(1).on('click', async function (event) {
                event.preventDefault();
                TagsPage = TagsPage + 1
                fetchTags({ page: TagsPage });
            })

            $('#subpage-tags').find('.subpageTagsContent').on('change', 'input[type="checkbox"]', function () {
                const value = this.value;
                const name = $(this).next('div').text()
                if (Tags.length >= 5 && this.checked) {
                    showInfo('danger', 'Please select no more than 5 tags.')
                    this.checked = false
                    return
                }
                if (this.checked) {
                    const content = `<span class="badge badge-info" id="${value}" style="margin-right:5px">${name}</span>`
                    $('.mainTags').prepend(content)
                    Tags.push(value)
                } else {
                    Tags = Tags.filter(item => item !== value);
                    $('#' + value).remove()
                }
            });

            //downloads
            $('.downloads-add').on('click', async function (event) {
                event.preventDefault();
                currentLang = $(this).data('lang')
                $('#subpage-name').text('Downloads');
                $('#subpage-guides').hide();
                $('#subpage-tags').hide();
                $('#subpage-downloads').show()
                Downloads[currentLang].map((item, index) => {
                    const dom = $('#subpage-downloads').find('#' + (index + 1)).find('input')
                    if (item && item.des) {
                        dom.eq(0).val(item.des);
                        dom.eq(1).val(item.path);
                    }
                })
                $('#subpage').show();
                document.body.style.overflow = 'hidden';
            })

            $('#subpage-downloads').on('click', '#subpage-submit', function () {
                event.preventDefault();
                $('#downloads-' + currentLang).find('.mainDownloads').find('.badge').remove()
                Downloads[currentLang] = $('#subpage-downloads .form-group')
                    .map((index, item) => {
                        const des = $(item).find('input').eq(0).val()
                        const path = $(item).find('input').eq(1).val()
                        if (des && path) {
                            const content = `<span class="badge badge-info" data-path ="${path}" style="margin-right:5px">${des}</span>`
                            $('#downloads-' + currentLang).find('.downloads-add').before(content)
                        }
                        return {
                            des: des,
                            path: path
                        };
                    })
                    .get();
                $('#subpage-downloads input').val('').end().hide().end()
                document.body.style.overflow = '';
                $('#subpage').hide()
            })

            //guides
            $('.guides-add').on('click', async function (event) {
                event.preventDefault();
                currentLang = $(this).data('lang')
                $('#subpage-name').text('Downloads');
                $('#subpage-guides').show();
                $('#subpage-tags').hide();
                $('#subpage-downloads').hide()
                Guides[currentLang].map((item, index) => {
                    const dom = $('#subpage-guides').find('#' + (index + 1)).find('input')
                    if (item && item.des) {
                        dom.eq(0).val(item.des);
                        dom.eq(1).val(item.path);
                    }
                })
                $('#subpage').show();
                document.body.style.overflow = 'hidden';
            })

            $('#subpage-guides').on('click', '#subpage-submit', function () {
                event.preventDefault();
                $('#guides-' + currentLang).find('.mainGuides').find('.badge').remove()
                Guides[currentLang] = $('#subpage-guides .form-group')
                    .map((index, item) => {
                        const des = $(item).find('input').eq(0).val()
                        const path = $(item).find('input').eq(1).val()
                        if (des && path) {
                            const content = `<span class="badge badge-info" data-path ="${path}" style="margin-right:5px">${des}</span>`
                            $('#guides-' + currentLang).find('.guides-add').before(content)
                        }
                        return {
                            des: des,
                            path: path
                        };
                    })
                    .get();
                $('#subpage-guides input').val('').end().hide().end()
                document.body.style.overflow = '';
                $('#subpage').hide()
            })

            //save
            $('#submit').on('click', async function () {
                event.preventDefault();
                const data = await disposalData()
                if (!data) return
                data.id = id
                let result
                if (data.id == 0) {
                    result = await fetchData('/admin/articles/detail', 'POST', data)
                } else {
                    result = await fetchData('/admin/articles/detail', 'PUT', data)
                }
                if (result.code == 1) {
                    showInfo('danger', result.messages)
                    return
                }
                if (result.code == 2) {
                    const dom = Object.keys(result.messages)[0] + ''
                    const value = Object.values(result.messages)[0][0]
                    $(dom).next('small').text(value)
                    return
                }
                window.history.replaceState(null, '', '/admin/articles/content');
                window.location.href = '/admin/articles/content';
            })
        })

        //images file
        $('#cover-images-file, #content-images-file').on('change', async function () {
            uploadImage(this);
        })

        //FetchTags
        async function fetchTags(params) {
            const tagsList = await fetchData('/admin/articles/tags/list', 'GET', params)
            $('#subpage-tags').find('#subpage-tags-content').empty()
            if (tagsList.data.totalPages == 0) {
                $('#subpage-tags').find('.subpagePagination').find('a').eq(0).text(0)
                $('#subpage-tags').find('.subpagePagination').find('a').eq(1).text(0)
                $('#subpage-tags').find('.subpagePagination').find('button').eq(0).prop('disabled', true)
                $('#subpage-tags').find('.subpagePagination').find('button').eq(1).prop('disabled', true)
                const content = `<div>No data available</div>`
                $('#subpage-tags').find('.subpageTagsContent').append(content)

            } else {
                const list = tagsList.data.list.map((item) => {
                    return { id: item._id, name: item.name, selected: Tags.includes(item._id) ? true : false }
                })
                list.map((item) => {
                    const content = `<div class="subpageTagsColumn">
                           <input type="checkbox" value="${item.id}" ${item.selected ? 'checked' : ''} style="margin-top:0">
                                    <div style="margin-left:10px">${item.name}</div>
                    </div>`

                    $('#subpage-tags').find('.subpageTagsContent').append(content)
                })
                $('#subpage-tags').find('.subpagePagination').find('a').eq(0).text(tagsList.data.page)
                $('#subpage-tags').find('.subpagePagination').find('a').eq(1).text(tagsList.data.totalPages)
                $('#subpage-tags').find('.subpagePagination').find('button').eq(0).prop('disabled', tagsList.data.page == 1)
                $('#subpage-tags').find('.subpagePagination').find('button').eq(1).prop('disabled', tagsList.data.page == tagsList.data.totalPages)
            }
        }

        //Update images
        async function uploadImage(fileInput) {
            if (!fileInput.files || !fileInput.files[0]) return;
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            const result = await fetchData('/admin/upload', 'POST', formData);
            if (result.code === 0) {
                showInfo('success', result.messages);
                const target = $(fileInput).data('item');
                const content = `
            <div style="display:flex;width:100%">
                <div class="coverImgDiv"
                     style="background-image:url(${result.data.url})"
                     data-path="${result.data.path}" id="${target}-en">
                </div>
                <div class="coverImgOpt" id="${target}-delete">
                    <i class="menu-icon fa fa-trash-o"></i>
                </div>
            </div>`;
                $('#' + target).find(`#${target}-add`).remove().end().prepend(content);
            } else {
                showInfo('danger', result.messages);
            }

        }


        //disposal data
        async function disposalData() {
            let data = {
                name: {},
                introduction: {},
                categories: [],
            }
            ConfigLang.map((item) => {
                data.name[item] = $('#name-' + item).val()
                data.introduction[item] = $('#introduction-' + item).val()
                if (item == 'en') {
                    data.categories = ($('#categories-' + item)).find('input[type="checkbox"]:checked').map(function () { return this.value; }).get()
                    data.coverImg = $(`#cover-image-` + item).attr('data-path')
                    data.contentImg = $('#content-image-' + item).attr('data-path')
                    data.tags = Tags
                    data.os = ($('#os-' + item)).find('input[type="checkbox"]:checked').map(function () { return this.value; }).get()
                }
            })
            data.guides = Guides
            data.downloads = Downloads
            console.log(data.coverImg)
            if (!data.name.en) {
                $('#name-en').next('small').text('name is required')
                return false
            }
            if (!data.introduction.en) {
                $('#introduction-en').next('small').text('introduction is required')
                return false
            }
            if (data.categories.length <= 0) {
                $('#categories-en').next('small').text('please select at least one category')
                return false
            }
            if (!data.coverImg) {
                $('#cover-image').next('small').text('cover image is required')
                return false
            }
            return data
        }

    </script>
