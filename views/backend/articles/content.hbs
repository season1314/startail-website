<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->


        <!-- Content -->
        <div class="content" style="min-height:calc(100vh - 240px)">
            <div class="animated fadeIn">
                <div class="row">
                    <div style="width:100%">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">Article List</strong>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px;height:80px;margin-bottom:0 !important">
                                <!-- -->
                                <div class="d-flex align-items-center">
                                    <input type="text" id="search-input" class="form-control form-control-sm me-2"
                                        placeholder="Article name" style="width:180px">
                                    <button id="btn-search" class="btn btn-primary btn-sm"
                                        style="margin-left:10px;">Search</button>
                                    <button id="btn-reset" class="btn btn-secondary btn-sm"
                                        style="margin-left:10px;">Reset</button>
                                </div>
                                <!--  -->
                                <button id="btn-add" class="btn btn-success btn-sm">New</button>
                            </div>

                            <div class="card-body" style="padding-top:0">
                                <div class="table-responsive">
                                    <table id="bootstrap-data-table" class="table table-striped" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Article Name</th>
                                                <th>Cover Image</th>
                                                <th>status</th>
                                                <th>CreateBy</th>
                                                <th>CreateAt</th>
                                                <th>Opt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- /.content -->
        <div class="clearfix"></div>

    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>
    <script src="/backend/js/bootstrap-table.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        $(document).ready(function () {
            //Init table by bootstrap-table.js
            const columns = [
                {
                    data: null,
                    render: function (data, type, row) {
                        const name = row.name.en.length > 20
                            ? row.name.en.slice(0, 20) + '...'
                            : row.name.en;
                        return name
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `<img src="${row.coverImg}" style="width:25px;height:25px"/>`
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        const isOnline = row.status === 0;
                        const btnClass = isOnline ? 'btn-success btn-status' : 'btn-danger btn-status';
                        const btnText = isOnline ? 'Online' : 'Offline';
                        const content = `<button class="btn btn-sm ${btnClass} btn-status" data-item="${row._id}">${btnText}</button>`;
                        return content
                    }
                },
                { data: "createdBy" },
                { data: "createdAt" },
                {
                    data: null,
                    render: function (data, type, row) {
                        const itemStr = JSON.stringify(row).replace(/"/g, '&quot;');
                        return ` <button class="btn btn-sm btn-info btn-info" data-item="${row._id}">view</button>
                        <button class="btn btn-sm btn-primary btn-edit" data-item="${row._id}">Edit</button>
                        <button class="btn btn-sm btn-danger btn-delete" data-item="${row._id}">Delete</button>`;
                    }
                }
            ];

            const table = initDataTable('#bootstrap-data-table', '/admin/articles/content/list', columns);


            //Handle new button
            $('#btn-add').on('click', function (event) {
                window.location.href = "/admin/articles/detail/0"
            })

            //Handle edit button
            $('#bootstrap-data-table').on('click', '.btn-edit', function () {
                const id = $(this).attr('data-item')
                window.location.href = "/admin/articles/detail/" + id
            });

            //Handle search
            $('#btn-search').on('click', async function () {
                event.preventDefault();
                const kw = $('#search-input').val()
                table.setKeyword(kw);
                table.ajax.reload();
            })

            //Clear search
            $('#btn-reset').on('click', async function () {
                event.preventDefault();
                $('#search-input').val('')
                table.setKeyword('');
                table.ajax.reload();
            })

            //Handle updateStatus
            $('#bootstrap-data-table').on('click', '.btn-status', async function () {
                const id = $(this).attr('data-item')
                if (!id) {
                    showInfo('danger', 'System error: id is null')
                    return
                }
                const result = await fetchData('/admin/articles/detail/' + id, 'PUT')
                if (result.code == 0) {
                    showInfo('success', result.messages)
                    table.ajax.reload(null, false)
                } else {
                    showInfo('danger', result.messages)
                }
            });

            //Handle delete
            $('#bootstrap-data-table').on('click', '.btn-delete', async function () {
                const id = $(this).attr('data-item')
                if (!id) {
                    showInfo('danger', 'System error: id is null')
                    return
                }
                openConfirm({
                    title: 'Confirm Delete',
                    context: 'Once the article is deleted,it cannot be undone. Are you sure you?',
                    onConfirm: async () => {
                        loading().show()
                        const result = await fetchData('/admin/articles/detail/', 'DELETE', {
                            id,
                        })
                        if (result.code !== 0) {
                            showInfo('danger', result.messages)
                        } else {
                            showInfo('success', result.messages)
                            table.ajax.reload()
                        }
                        loading().hide()
                    }
                })
            })
        });
    </script>
</body>
<style>
</style>

</html>