<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}
    {{> backend/tags}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->


        <!-- Content -->
        <div class="content">
            <div class="animated fadeIn">
                <div class="row">
                    <div style="width:100%">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">Tags List</strong>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px;height:80px;margin-bottom:0 !important">

                                <div class="d-flex align-items-center">
                                    <input type="text" id="search-input" class="form-control form-control-sm me-2"
                                        placeholder="Tags name keyword" style="width:180px">
                                    <button id="btn-search" class="btn btn-primary btn-sm"
                                        style="margin-left:10px;">Search</button>
                                    <button id="btn-reset" class="btn btn-secondary btn-sm"
                                        style="margin-left:10px;">Reset</button>
                                </div>

                                <button id="btn-add" class="btn btn-success btn-sm">New</button>
                            </div>

                            <div class="card-body" style="padding-top">
                                <div class="table-responsive">
                                    <table id="bootstrap-data-table" class="table table-striped table-fixed"
                                        style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Tag Name</th>
                                                <th>Display Name</th>
                                                <th>Type</th>
                                                <th>CreateBy</th>
                                                <th>CreateAt</th>
                                                <th>Opt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- /.content -->
        <div class="clearfix"></div>
    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>
    <script src="/backend/js/bootstrap-table.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        let _data;
        $(document).ready(function () {
            //Init table by bootstrap-table.js
            const columns = [
                { data: "name" },
                { data: "display" },
                { data: "type" },
                { data: "createdBy" },
                { data: "createdAt" },
                {
                    data: null,
                    render: function (data, type, row) {
                        const itemStr = JSON.stringify(row).replace(/"/g, '&quot;');
                        return `<button class="btn btn-sm btn-primary btn-edit" data-item="${itemStr}">Edit</button>
                        <button class="btn btn-sm btn-danger btn-delete" data-item="${row._id}">Delete</button>`;
                    }
                }
            ];

            const table = initDataTable('#bootstrap-data-table', '/admin/articles/tags/list', columns);


            //Handle new button
            $('#btn-add').on('click', function (event) {
                event.preventDefault();
                const data = $('#bootstrap-data-table').data('lang')
                $('#subpage-title').text('Create New');
                $('#subpage-create').show();
                data.map((item) => {
                    const content = `<div class='row form-group temporary'>
                            <div class='col col-md-3'><label for='text-input' class='form-control-label'>${Object.values(item)}
                                ${Object.keys(item) == 'en' ? '<span style="color:red">*</span>' : ''}</label></div>
                            <div class='col-12 col-md-9'>
                                <input type='text' name='create-lang'placeholder='display name' class='form-control create-lang' id='create-lang-${Object.keys(item)}' />
                                <small class="help-block form-text color-red" style="height:12px"></small></div>
                            </div>`
                    $('#create').after(content)
                })
                $('#subpage-edit').hide();
                $('#subpage').show();
            })

            //Handle subpage create submit
            $('#subpage-create-submit').on('click', async function (event) {
                event.preventDefault();
                const name = $('#create-name').val();
                const type = $('#create-type').val();
                const _lang = $('#bootstrap-data-table').data('lang')
                const lang = _lang.map((item) => {
                    const key = Object.keys(item)[0]
                    const value = $('#create-lang-' + key).val()
                    return { [key]: value }
                })
                const result = await fetchData('/admin/articles/tags', 'POST', {
                    name,
                    type,
                    lang
                });
                if (result.code == 2) {
                    subpageError(result.messages, 'create')
                } else if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else {
                    showInfo('success', result.messages)
                    $('#subpage')
                        .find('input:not([type="radio"])').val('').end()
                        .find('.temporary').remove().end()
                        .find('input[type="radio"]').prop('checked', false).end()
                        .find('small').text('').end()
                        .hide();
                    table.setKeyword('');
                    $('#search-input').val('')
                    table.ajax.reload()
                }
            })

            //Create reset
            $('#subpage-create-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                $('#subpage').find('input').val('').end().find('small').text('').end()
            });


            //Handle edit button
            $('#bootstrap-data-table').on('click', '.btn-edit', function () {
                const data = JSON.parse($(this).attr('data-item'));
                _data = data
                const lang = $('#bootstrap-data-table').data('lang')
                $('#subpage-title').text('Edit');
                $('#subpage-create').hide();
                $('#subpage-edit').show();
                lang.map((item) => {
                    const content = `<div class='row form-group temporary'>
                            <div class='col col-md-3'><label for='text-input' class='form-control-label'>${Object.values(item)}
                                ${Object.keys(item) == 'en' ? '<span style="color:red">*</span>' : ''}</label></div>
                            <div class='col-12 col-md-9'>
                                <input type='text' name='create-lang'placeholder='display name' class='form-control create-lang' id='edit-lang-${Object.keys(item)}' />
                                <small class="help-block form-text color-red" style="height:12px"></small></div>
                            </div>`
                    $('#edit').after(content).end()
                })
                $('#edit-name').data('id', _data._id);
                $('#edit-name').val(_data.name)
                $('#edit-type').val(_data.type)
                data.lang.map((item) => {
                    const id = '#edit-lang-' + Object.keys(item)
                    if (id) $(id).val(Object.values(item))
                })
                $('#subpage').show();
            });

            //Handle subpage editInfo submit
            $('#subpage-edit-submit').on('click', async function (event) {
                event.preventDefault();
                const id = $('#edit-name').data('id')
                const name = $('#edit-name').val();
                const type = $('#edit-type').val();
                const _lang = $('#bootstrap-data-table').data('lang')
                const lang = _lang.map((item) => {
                    const key = Object.keys(item)[0]
                    const value = $('#edit-lang-' + key).val()
                    return { [key]: value }
                })
                const result = await fetchData('/admin/articles/tags', 'PUT', {
                    id,
                    name,
                    type,
                    lang
                })
                if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else if (result.code == 2) {
                    subpageError(result.messages, 'edit')
                } else {
                    showInfo('success', result.messages)
                    $('#subpage')
                        .find('input:not([type="radio"])').val('').end()
                        .find('.temporary').remove().end()
                        .find('input[type="radio"]').prop('checked', false).end()
                        .find('small').text('').end()
                        .hide();
                    table.ajax.reload(null, false)
                }
            })

            //edit reset
            $('#subpage-edit-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                $('#edit-name').data('id', _data.id);
                $('#edit-name').val(_data.name)
                $('#edit-type').val(_data.type)
                _data.lang.map((item) => {
                    const id = '#edit-lang-' + Object.keys(item)
                    if (id) $(id).val(Object.values(item))
                })
            });



            //Handle delete button
            $('#bootstrap-data-table').on('click', '.btn-delete', function () {
                const id = $(this).attr('data-item');
                openConfirm({
                    title: 'Confirm Delete',
                    context: 'Deleting this tag may result in users being unable to access this functionality.',
                    onConfirm: async () => {
                        loading().show()
                        const result = await fetchData('/admin/articles/tags', 'DELETE', {
                            id,
                        })
                        if (result.code !== 0) {
                            showInfo('danger', result.messages)
                        } else {
                            showInfo('success', result.messages)
                            table.ajax.reload()
                        }
                        loading().hide()
                    }
                })
            });

            //Handle search
            $('#btn-search').on('click', async function () {
                event.preventDefault();
                const kw = $('#search-input').val()
                table.setKeyword(kw);
                table.ajax.reload();
            })


            //Clear search
            $('#btn-reset').on('click', async function () {
                event.preventDefault();
                $('#search-input').val('')
                table.setKeyword('');
                table.ajax.reload();
            })



        });
    </script>
</body>
<style>
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
    }

    #bootstrap-data-table {
        table-layout: auto;
        width: 100%;
    }

    #bootstrap-data-table th,
    #bootstrap-data-table td {
        white-space: nowrap;
    }

    /*
    .table-fixed tbody {
        display: block;
        max-height: (100vh - 1500px);
        overflow-y: auto;
    }

    .table-fixed thead,
    .table-fixed tbody tr {
        display: table;
        width: 100%;
        table-layout: fixed;
    }
   */
</style>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

</html>