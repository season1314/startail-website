<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
    <link rel="stylesheet" href="/backend/css/spinner.css">
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->


        <!-- Content -->
        <div class="content" style="min-height:calc(100vh - 240px)">
            <div class="animated fadeIn">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">Permissions List</strong>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px;height:80px">
                                <!--  -->
                                <div class="d-flex align-items-center">
                                    <input type="text" id="search-input" class="form-control form-control-sm me-2"
                                        placeholder="keyword" style="width:180px">
                                    <button id="btn-search" class="btn btn-primary btn-sm"
                                        style="margin-left:10px;">Search</button>
                                    <button id="btn-reset" class="btn btn-secondary btn-sm"
                                        style="margin-left:10px;">Reset</button>
                                </div>
                                <button id="submit" class="btn btn-success btn-sm">
                                    <span class="btn-text">Save</span>
                                    <span class="spinner"></span></button>
                            </div>
                            <div class="card-body" style="padding-top: 0">
                                <div class="permission-list">

                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- /.content -->
        <div class="clearfix"></div>
        <!-- Footer -->
        {{> backend/footer}}
        <!-- /.site-footer -->
    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>
    <script src="/backend/js/init/datatables-init.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        window.addEventListener('DOMContentLoaded', async () => {
            //Init data
            const params = new URLSearchParams(window.location.search);
            window.adminId = params.get('id');
            fetchList()
        });


        //FetchData
        async function fetchList() {
            const getData = await fetchData('/admin/admin/permissions/list', 'GET', { id: window.adminId });
            if (getData.code !== 0) { showInfo('danger', getData.messages.message ? getData.messages.message : getData.messages); return }
            if (getData.data.list.length > 0) {
                $('.permission-list').empty()
                getData.data.list.map((item, index) => {
                    const context = `<div class="permission-item">
                                        <input type="checkbox" id="inline-checkbox${index}" name="inline-checkbox${index}"
                                            value="${item.key}" class="form-check-input" ${item.selected ? 'checked' : ''}  ${item.disabled ? 'disabled' : ''} style="margin-top:0">
                                    <div>${item.name} : (${item.des})</div>
                                    </div>      
                                 `
                    $('.permission-list').append(context)
                })
            } else {
                $('.permission-list').empty()
                const context = '<div>No data found</div>'
                $('.permission-list').append(context)
            }
        }

        //Handle search
        $(document).on('click', '#btn-search', function () {
            const keyword = $('#search-input').val()

            if (!keyword) {
                $('.permission-item').show();
                return;
            }

            $('.permission-item').each(function () {
                const text = $(this).find('div').text();
                if (text.indexOf(keyword) === -1) {
                    $(this).hide();
                } else {
                    $(this).show();
                }
            });
        })

        //Handle reset
        $(document).on('click', '#btn-reset', function () {
            $('#search-input').val('')
            $('.permission-item').show();
        })


        //Handle submit
        $(document).on('click', '#submit', async function () {
            event.preventDefault();
            if ($('#submit').prop('disabled')) return
            $('#submit').addClass('loading').prop('disabled', true)
            const permissions = $('input[type="checkbox"]:checked').map(function () { return $(this).val(); }).get();
            const result = await fetchData('/admin/admin/permissions', 'PUT', { id: window.adminId, permissions })
            if (result.code !== 0) {
                showInfo('danger', result.messages)
            } else {
                showInfo('success', result.messages)
                fetchList()
            }
            $('#submit').removeClass('loading').prop('disabled', false)
        })

    </script>
</body>
<style>
    .permission-list {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        padding: 0 30px
    }

    .permission-item {
        padding: 0 30px;
        display: flex;
        height: 20px;
        justify-items: center;
        align-items: center;
    }
</style>

</html>