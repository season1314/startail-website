<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}
    {{> backend/admin}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->


        <!-- Content -->
        <div class="content" style="min-height:calc(100vh - 240px)">
            <div class="animated fadeIn">
                <div class="row">
                    <div style="width:100%">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">Administrator List</strong>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px;height:80px">

                                <div class="d-flex align-items-center">
                                    <input type="text" id="search-input" class="form-control form-control-sm me-2"
                                        placeholder="Username /Email / Name" style="width:180px">
                                    <button id="btn-search" class="btn btn-primary btn-sm"
                                        style="margin-left:10px;">Search</button>
                                    <button id="btn-reset" class="btn btn-secondary btn-sm"
                                        style="margin-left:10px;">Reset</button>
                                </div>

                                <button id="btn-add" class="btn btn-success btn-sm">New</button>
                            </div>

                            <div class="card-body" style="padding-top: 0">
                                <div class="table-responsive" style="max-width: 100%; overflow-x: auto;">
                                    <table id="bootstrap-data-table" class="table table-striped"
                                        style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Username</th>
                                                <th>NickName</th>
                                                <th>Email</th>
                                                <th>Status</th>
                                                <th>Password</th>
                                                <th>Permissions</th>
                                                <th>CreatedTime</th>
                                                <th>CreatedBy</th>
                                                <th>Opt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- /.content -->
        <div class="clearfix"></div>
        <!-- Footer -->
        {{> backend/footer}}
        <!-- /.site-footer -->
    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>
    <script src="/backend/js/bootstrap-table.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        let _date;
        $(document).ready(function () {
            //Init table by bootstrap-table.js
            const columns = [
                { data: 'username' },
                { data: 'nickname' },
                { data: 'email' },
                {
                    data: null,
                    render: function (data, type, row) {
                        const isOnline = row.status === 0;
                        const btnClass = isOnline ? 'success' : 'secondary';
                        const btnText = isOnline ? 'On' : 'Off';
                        return `<button class="btn btn-${btnClass} btn-sm btn-status" data-item="${row._id}">${btnText}</button>`;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        const item = JSON.stringify(row).replace(/"/g, '&quot;');
                        return `<button class="btn btn-sm btn-danger btn-password" data-item="${item}">Reset</button>`
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `<button class="btn btn-sm btn-primary btn-permissions" data-item="${row._id}">Set</button`
                    }
                },
                { data: "createdAt" },
                {
                    data: null,
                    render: function (data, type, row) {
                        const createdBy = row.createdBy ? row.createdBy : 'System'
                        return createdBy
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        const itemStr = JSON.stringify(row).replace(/"/g, '&quot;');
                        return `<button class="btn btn-sm btn-primary btn-edit" data-item="${itemStr}">Edit</button>
                        <button class="btn btn-sm btn-danger btn-delete" data-item="${row._id}">Delete</button>`;
                    }
                }
            ];
            const table = initDataTable('#bootstrap-data-table', '/admin/admin/list', columns);

            //Create
            $('#btn-add').on('click', function (event) {
                event.preventDefault();
                $('#subpage-title').text('Create New');
                $('#subpage-create').show();
                $('#subpage-edit').hide();
                $('#subpage-password').hide();
                $('#subpage-permissions').hide()
                $('#subpage').show();
            })

            $('#subpage-create-submit').on('click', async function (event) {
                event.preventDefault();
                const username = $('#create-username').val();
                const password = $('#create-password').val();
                const confirmPassword = $('#create-confirmPassword').val();
                const email = $('#create-email').val();
                const nickname = $('#create-nickname').val();
                const result = await fetchData('/admin/admin', 'POST', {
                    username,
                    password,
                    confirmPassword,
                    email,
                    nickname,
                });
                if (result.code == 2) {
                    subpageError(result.messages, 'create')
                } else if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else {
                    showInfo('success', result.messages)
                    table.setKeyword('');
                    table.ajax.reload()
                    $('#subpage').find('input').val('').end().find('small').text('').end().hide();
                }
            })

            $('#subpage-create-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                $('#subpage')
                    .find('input')
                    .val('')
                    .end()
                    .find('small')
                    .text('')
                    .end()
            });


            //Edit
            $('#bootstrap-data-table').on('click', '.btn-edit', function () {
                const item = JSON.parse($(this).attr('data-item'));
                _data = item
                Object.entries(_data).forEach(([key, value]) => {
                    if (key == '_id') $('#edit-username').data('id', value);
                    const dom = $('#edit-' + key)
                    if (!dom) return
                    dom.prop('tagName') == 'P' ? dom.text(value) : dom.val(value)
                })
                $('#subpage-title').text('Edit Info');
                $('#subpage-create').hide();
                $('#subpage-password').hide();
                $('#subpage-edit').show();
                $('#subpage-permissions').hide()
                $('#subpage').show();
            });


            $('#subpage-edit-submit').on('click', async function (event) {
                event.preventDefault();
                const id = $('#edit-username').data('id');
                const username = $('#edit-username').text();
                const email = $('#edit-email').val();
                const nickname = $('#edit-nickname').val();
                const result = await fetchData('/admin/admin', 'PUT', {
                    id,
                    username,
                    email,
                    nickname,
                    type: 'editInfo'
                })
                if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else if (result.code == 2) {
                    subpageError(result.messages, 'edit')
                } else {
                    showInfo('success', result.messages)
                    table.ajax.reload(null, false)
                    $('#subpage').find('input').val('').end().find('small').text('').end().hide();
                }
            })

            $('#subpage-edit-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                Object.entries(_data).forEach(([key, value]) => {
                    const dom = $('#edit-' + key)
                    if (!dom) return
                    dom.prop('tagName') == 'P' ? dom.text(value) : dom.val(value)
                })
            });

            //Rest password
            $('#bootstrap-data-table').on('click', '.btn-password', function () {
                const item = JSON.parse($(this).attr('data-item'));
                _data = item
                Object.entries(_data).forEach(([key, value]) => {
                    if (key == '_id') $('#password-username').data('id', value);
                    const dom = $('#password-' + key)
                    if (!dom) return
                    dom.prop('tagName') == 'P' ? dom.text(value) : dom.val(value)
                })
                $('#subpage-title').text('Rest Password');
                $('#subpage-create').hide();
                $('#subpage-edit').hide();
                $('#subpage-password').show();
                $('#subpage-permissions').hide()
                $('#subpage').show();
            });

            $('#subpage-password-submit').on('click', async function (event) {
                event.preventDefault();
                const id = $('#password-username').data('id');
                const password = $('#password-password').val();
                const confirmPassword = $('#password-confirmPassword').val()
                const result = await fetchData('/admin/admin', 'PUT', {
                    id,
                    password,
                    confirmPassword,
                    type: 'resetPass'
                })
                if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else if (result.code == 2) {
                    subpageError(result.messages, 'password')
                } else {
                    showInfo('success', result.messages)
                    $('#subpage').find('input').val('').end().find('small').text('').end().hide();
                }
            });

            $('#subpage-password-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                $('#subpage')
                    .find('input')
                    .val('')
                    .end()
                    .find('small')
                    .text('')
                    .end()
            });

            //Delete
            $(document).on('click', '.btn-delete', function () {
                const id = $(this).attr('data-item');
                openConfirm({
                    title: 'Confirm Delete',
                    context: 'Once the admin is deleted,it cannot be undone. Are you sure you?',
                    onConfirm: async () => {
                        loading().show()
                        const result = await fetchData('/admin/admin', 'DELETE', {
                            id,
                        })
                        if (result.code !== 0) {
                            showInfo('danger', result.messages)
                        } else {
                            showInfo('success', result.messages)
                            table.ajax.reload()
                        }
                        loading().hide()
                    }
                })
            });

            //Permission
            $('#bootstrap-data-table').on('click', '.btn-permissions', function () {
                const id = $(this).attr('data-item');
                window.location.href = "/admin/admin/permissions?id=" + id
            });

            //Switch
            $('#bootstrap-data-table').on('click', '.btn-status', async function () {
                const id = $(this).attr('data-item');
                loading().show()
                const result = await fetchData('/admin/admin', 'PUT', {
                    id,
                    type: 'switchStatus'
                })
                if (result.code !== 0) {
                    showInfo('danger', result.messages)
                } else {
                    showInfo('success', result.messages)
                    table.ajax.reload()
                }
                loading().hide()
            })
            //Handle search
            $('#btn-search').on('click', async function () {
                event.preventDefault();
                const kw = $('#search-input').val()
                table.setKeyword(kw);
                table.ajax.reload();
            })


            //Clear search
            $('#btn-reset').on('click', async function () {
                event.preventDefault();
                $('#search-input').val('')
                table.setKeyword('');
                table.ajax.reload();
            })

        })
    </script>
</body>
<style>
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
    }

    #bootstrap-data-table {
        table-layout: auto;
        width: 100%;
    }

    #bootstrap-data-table th,
    #bootstrap-data-table td {
        white-space: nowrap;
    }
</style>

</html>