<!doctype html>
<!--[if lt IE 7]>      <html class="no-js lt-ie9 lt-ie8 lt-ie7" lang=""> <![endif]-->
<!--[if IE 7]>         <html class="no-js lt-ie9 lt-ie8" lang=""> <![endif]-->
<!--[if IE 8]>         <html class="no-js lt-ie9" lang=""> <![endif]-->
<!--[if gt IE 8]><!-->
<html class="no-js" lang=""> <!--<![endif]-->

<head>
    {{> backend/head title=title}}
</head>

<body>
    {{> backend/infobar}}
    {{> backend/confirm}}
    {{> backend/loading}}
    {{> backend/admin}}

    <!-- Left Panel -->
    {{> backend/sidebar title=title}}
    <!-- /#left-panel -->

    <!-- Right Panel -->
    <div id="right-panel" class="right-panel">

        <!-- Header-->
        {{> backend/header}}
        <!-- /#header -->

        <!-- Breadcrumbs -->
        {{> backend/breadcrumbs bc=bc}}
        <!-- /#Breadcrumbs -->


        <!-- Content -->
        <div class="content" style="min-height:calc(100vh - 240px)">
            <div class="animated fadeIn">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <strong class="card-title">Administrator List</strong>
                            </div>
                            <div class="table-actions mb-3 d-flex align-items-center justify-content-between"
                                style="padding: 0 35px;height:80px">
                                
                                <div class="d-flex align-items-center">
                                    <input type="text" id="search-input" class="form-control form-control-sm me-2"
                                        placeholder="Username /Email / Name" style="width:180px">
                                    <button id="btn-search" class="btn btn-primary btn-sm"
                                        style="margin-left:10px;">Search</button>
                                    <button id="btn-reset" class="btn btn-secondary btn-sm"
                                        style="margin-left:10px;">Reset</button>
                                </div>
               
                                <button id="btn-add" class="btn btn-success btn-sm">New</button>
                            </div>

                            <div class="card-body" style="padding-top: 0">
                                <div class="table-responsive" style="max-width: 100%; overflow-x: auto;">
                                    <table id="bootstrap-data-table" class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Username</th>
                                                <th>NickName</th>
                                                <th>Email</th>
                                                <th>Status</th>
                                                <th>Password</th>
                                                <th>Permissions</th>
                                                <th>CreateTime</th>
                                                <th>CreateBy</th>
                                                <th>Opt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div><!-- .animated -->
        </div><!-- .content -->

        <!-- /.content -->
        <div class="clearfix"></div>
        <!-- Footer -->
        {{> backend/footer}}
        <!-- /.site-footer -->
    </div>
    <!-- /#right-panel -->


    <!-- Scripts -->
    {{> backend/script }}


    <script src="/backend/js/lib/data-table/datatables.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/dataTables.buttons.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.bootstrap.min.js"></script>
    <script src="/backend/js/lib/data-table/jszip.min.js"></script>
    <script src="/backend/js/lib/data-table/vfs_fonts.js"></script>
    <script src="/backend/js/lib/data-table/buttons.html5.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.print.min.js"></script>
    <script src="/backend/js/lib/data-table/buttons.colVis.min.js"></script>
    <script src="/backend/js/init/datatables-init.js"></script>

    <!--Local Stuff-->
    <script type="text/javascript">
        window.addEventListener('DOMContentLoaded', async () => {
            var page = 1
            //Init data
            fetchList(page)

            //Handle new button
            $('#btn-add').on('click', function (event) {
                event.preventDefault();
                subpageOpen().create()
            })

            //Handle subpage create submit
            $('#subpage-create-submit').on('click', async function (event) {
                event.preventDefault();
                const username = $('#create-username').val();
                const password = $('#create-password').val();
                const confirmPassword = $('#create-confirmPassword').val();
                const email = $('#create-email').val();
                const nickname = $('#create-nickname').val();
                const result = await fetchData('/admin/admin', 'POST', {
                    username,
                    password,
                    confirmPassword,
                    email,
                    nickname,
                });
                if (result.code == 2) {
                    subpageError(result.messages, 'create')
                } else if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else {
                    showInfo('success', result.messages)
                    $('#subpage').find('input').val('').end().find('small').text('').end().hide();
                    page = 1
                    fetchList(page)
                }
            })
            $('#subpage-create-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                subpageReset().create()
            });

            //Handle subpage editInfo submit
            $('#subpage-edit-submit').on('click', async function (event) {
                event.preventDefault();
                const id = $('#edit-username').data('id');
                const username = $('#edit-username').text();
                const email = $('#edit-email').val();
                const nickname = $('#edit-nickname').val();
                const result = await fetchData('/admin/admin', 'PUT', {
                    id,
                    username,
                    email,
                    nickname,
                    type: 'editInfo'
                })
                if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else if (result.code == 2) {
                    subpageError(result.messages, 'edit')
                } else {
                    showInfo('success', result.messages)
                    $('#subpage').find('input').val('').end().find('small').text('').end().hide();
                    fetchList(page)
                }
            })

            $('#subpage-edit-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                subpageReset().edit()
            });

            //update password
            $('#subpage-password-submit').on('click', async function (event) {
                event.preventDefault();
                const id = $('#password-username').data('id');
                const password = $('#password-password').val();
                const confirmPassword = $('#password-confirmPassword').val()
                const result = await fetchData('/admin/admin', 'PUT', {
                    id,
                    password,
                    confirmPassword,
                    type: 'resetPass'
                })
                if (result.code == 1) {
                    showInfo('danger', result.messages)
                } else if (result.code == 2) {
                    subpageError(result.messages, 'password')
                } else {
                    showInfo('success', result.messages)
                    $('#subpage').find('input').val('').end().find('small').text('').end().hide();
                }
            });

            $('#subpage-password-submit').next('button').on('click', async function (event) {
                event.preventDefault();
                subpageReset().create()
            });
        });


        //FetchData
        async function fetchList(page) {
            const getData = await fetchData('/admin/admin/list', 'GET', { page });
            const html = getData.data.list.map(item => {
                const itemStr = JSON.stringify(item).replace(/"/g, '&quot;');
                return `<tr>
                      <td>${item.username}</td>
                      <td>${item.nickname ? item.nickname : ''}</td>
                      <td>${item.email}</td>
                      <td>${item.status === 0 || item.status === 2? `<button class="btn btn-success btn-sm">On</button>` : `<button class="btn btn-secondary btn-sm">Off</button>`}</td>
                      <td><button class="btn btn-sm btn-danger btn-password" data-item="${itemStr}">Reset</button></td>
                      <td><button class="btn btn-sm btn-primary btn-permissions" data-item="${item._id}">Set</button></td>
                      <td>${item.createdAt}</td>
                      <td>${item.createdBy ? item.createdBy : 'System'}</td>
                      <td>
                        <button class="btn btn-sm btn-primary btn-edit" data-item="${itemStr}">Edit</button>
                        <button class="btn btn-sm btn-danger btn-delete" data-item="${item._id}">Delete</button>
                      </td>
                      </tr>`}).join('');
            $('#bootstrap-data-table tbody').html(html);
        }

        //Handle edit button
        $(document).on('click', '.btn-edit', function () {
            const item = JSON.parse($(this).attr('data-item'));
            subpageOpen().edit(item)
        });

        //Handle reset password button
        $(document).on('click', '.btn-password', function () {
            const item = JSON.parse($(this).attr('data-item'));
            subpageOpen().password(item)
        });
        //Handle delete button
        $(document).on('click', '.btn-delete', function () {
            const id = $(this).attr('data-item');
            openConfirm({
                title: 'Confirm Delete',
                context: 'Once the admin is deleted,it cannot be undone. Are you sure you?',
                onConfirm: async () => {
                    loading().show()
                    const result = await fetchData('/admin/admin', 'DELETE', {
                        id,
                    })
                    if (result.code !== 0) {
                        showInfo('danger', result.messages)
                    } else {
                        showInfo('success', result.messages)
                        $(this).closest('tr').remove();
                    }
                    loading().hide()
                }
            })
        });

        //Handle permission set button
        $(document).on('click', '.btn-permissions', function () {
            const id = $(this).attr('data-item');
            window.location.href = "/admin/admin/permissions?id=" + id 
        });

    </script>
</body>
<style>
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-width: 100%;
    }

    #bootstrap-data-table {
        table-layout: auto;
        width: 100%;
    }

    #bootstrap-data-table th,
    #bootstrap-data-table td {
        white-space: nowrap;
    }
</style>

</html>