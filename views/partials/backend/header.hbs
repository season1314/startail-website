<header id="header" class="header">
    <div class="top-left">
        <div class="navbar-header">
            <a class="navbar-brand" href="./"><img src="/backend/img/logo.png" alt="Logo"></a>
            <a class="navbar-brand hidden" href="./"><img src="/backend/img/logo2.png" alt="Logo"></a>
            <a id="menuToggle" class="menutoggle"><i class="fa fa-bars"></i></a>
        </div>
    </div>
    <div class="top-right">
        <div class="header-menu">
            <div class="header-left" />


            <div class="user-area dropdown float-right">
                <a href="#" class="dropdown-toggle active" data-toggle="dropdown" aria-haspopup="true"
                    aria-expanded="false">
                    <img class="user-avatar rounded-circle" src="" id="header-avatar">
                </a>

                <div class="user-menu dropdown-menu">
                    <a class="nav-link" href="/admin/auth"><i class="fa fa- user"></i>My Profile</a>

                    <a class="nav-link" id="logout" style="cursor:pointer"><i class="fa fa-power -off"></i>Logout</a>
                </div>
            </div>

        </div>
    </div>
</header>
<script>
    //Handle logout
    $(document).on('click', '#logout', async function () {
        event.preventDefault();
        const result = await fetchData('/admin/auth', 'DELETE')
    });

    //Refresh administrator info 
    window.addEventListener('DOMContentLoaded', async () => {
        let avatar = localStorage.getItem('avatar');
        const fromUrl = document.referrer;
        let path = ''
        if (fromUrl) path = new URL(fromUrl).pathname
        if (!path) {
            const result = await fetchData('/admin/auth', 'POST');
            avatar = result.data.avatar
            localStorage.setItem('avatar', avatar)
        }
        $('#header-avatar').attr('src', avatar)
    })
</script>