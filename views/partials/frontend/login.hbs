<div class="form login" id="login" style="{{#not user.sub}}display:block{{/not}}">
    <a class="title">Login to your account</a>
    <div id="loginBox">
        <form>
            <div class="column" id="email">
                <label>Email</label>
                <input type="text" placeholder="m@example.com"></input>
                <a></a>
            </div>
            <div class="column" id="password">
                <label>Password</label>
                <input type="password" placeholder=""></input>
                <a></a>
            </div>
        </form>
        <button class="dark" id="loginSubmit">
            <span class="spinner"></span>
            <a>Submit</a>
        </button>
    </div>
    <div class="link">
        <a href="#" onclick="window.location.replace('/auth/register')">Sign Up</a>
        <a href="#" onclick="window.location.replace('/auth/reset')">Forget Password?</a>
    </div>
</div>
<script>

    //Handle login
    $(document).on('click', '#loginSubmit', async function () {
        $(this).find('.spinner').addClass('is-show')
        $(this).find('a').css('display', 'none')
        $(this).prop('disabled', true)
        $('#loginBox').find('input').prop('disabled', true)
        const $email = $('#email').find('input')
        const $password = $('#password').find('input')
        const res = await fetchData('/auth/login', 'POST', { email: $email.val(), password: $password.val() })
        if (res.code == 2) {
            Object.entries(res.messages).forEach(([key, value]) => {
                $(`#${key}`).find('a').text(value[0])
            })
        }
        if (res.code == 0) {
            $('#login').css('display', 'none')
            const avatar = res.data.user.nickname.charAt(0).toUpperCase()
            $('#user').find('.avatar').text(avatar)
            $('#user').find('.email').text(res.data.user.email)
            $('#user').find('.nickname').text(res.data.user.nickname)
            $('#user').css('display', 'flex')
            localStorage.setItem('user', JSON.stringify(res.data.user));
        }
        $(this).find('.spinner').removeClass('is-show')
        $(this).find('a').css('display', 'block')
        $(this).prop('disabled', false)
        $('#loginBox').find('input').prop('disabled', false)
        return
    })

    //Clear error info
    $('input').focus(function () {
        const $small = $(this).next('a');
        $small.text('');
    });


    //Handle Logout
    $(document).on('click', '#logout', function () {
        $('#login').css('display', 'block')
        $('#user').css('display', 'none')
        document.cookie = `token=""; path=/; Secure; SameSite=Strict`;
        localStorage.removeItem('user')

    })

    //Handle operation
    $(document).on('click', '.svg', function () {
        const url = $(this).data('url')
        if (url) window.location.href = url
        return
    })

</script>