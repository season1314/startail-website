<link rel="stylesheet" href="/frontend/css/form.css">
<div class="form">
    <a class="title">Login to your account</a>
    <form>
        <div class="column" id="email">
            <label>Email</label>
            <input type="text" placeholder="m@example.com"></input>
            <a></a>
        </div>
        <div class="column" id="password">
            <label>Password</label>
            <input type="password" placeholder=""></input>
            <a></a>
        </div>
    </form>
    <button class="dark">Login</button>
    <div class="link">
        <a href="/auth/register">Sign Up</a>
        <a href="/auth/register">Forget Password?</a>
    </div>
</div>