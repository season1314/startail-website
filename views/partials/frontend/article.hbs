{{#each articleList}}
<div class="article" id="{{this._id}}">
    <h3 class="title">{{this.title}}</h3>
    <div class="non-expend">
        <div class="img" style="background-image: url('{{this.coverImg}}');"></div>
        <div class="content">
            <p class="text">
                {{this.des}}
            </p>
        </div>
    </div>
    <div class="expend">
        <img class="img" src="{{this.coverImg}}" />
        <div class="content">
            {{this.des}}
        </div>
        {{#if this.files}}
        <div class="files">
            {{#each this.files}}
            {{#if this.des}}
            {{#if this.path}}
            <div>
                <a class="label">{{this.des}} : </a>
                <a href={{this.path}} target="_blank" rel="noopener noreferrer" class="link">
                    {{this.path}}
                </a>
            </div>
            {{/if}}
            {{/if}}
            {{/each}}
        </div>
        {{/if}}
    </div>
    <div class="tags">
        {{#each this.tags}}
        <a href="#" class="badge {{this.active}}"
            onclick="window.location.replace('/tags/{{this.id}}')">{{this.name}}</a>
        {{/each}}
    </div>
    <div class="create">
        <a>Created By {{this.createdInfo.name}} {{this.createdAt}}</a>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
            class="svg des" data-id="{{this._id}}">
            <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0-3.75-3.75M17.25 21 21 17.25" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
            class="svg des" style="display:none" data-id="{{this._id}}">
            <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 4.5h14.25M3 9h9.75M3 13.5h5.25m5.25-.75L17.25 9m0 0L21 12.75M17.25 9v12" />
        </svg>
    </div>
    <div class="expend">
        <div class="article-operations">
            <button class="operation favorite" data-id="{{this._id}}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="operation-svg">
                    <path fill-rule="evenodd"
                        d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z"
                        clip-rule="evenodd" />
                </svg>
                <a>favorite</a>
            </button>
            <button class="operation cmt" data-id="{{this._id}}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="operation-svg">
                    <path fill-rule="evenodd"
                        d="M4.804 21.644A6.707 6.707 0 0 0 6 21.75a6.721 6.721 0 0 0 3.583-1.029c.774.182 1.584.279 2.417.279 5.322 0 9.75-3.97 9.75-9 0-5.03-4.428-9-9.75-9s-9.75 3.97-9.75 9c0 2.409 1.025 4.587 2.674 6.192.232.226.277.428.254.543a3.73 3.73 0 0 1-.814 1.686.75.75 0 0 0 .44 1.223ZM8.25 10.875a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25ZM10.875 12a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875-1.125a1.125 1.125 0 1 0 0 2.25 1.125 1.125 0 0 0 0-2.25Z"
                        clip-rule="evenodd" />
                </svg>
                <a>comment</a>
            </button>
            <button class="operation view" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="operation-svg"
                    style="padding-top:2px">
                    <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                    <path fill-rule="evenodd"
                        d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z"
                        clip-rule="evenodd" />
                </svg>
                <a>view</a>
            </button>
        </div>
        <div class="comment">
            <div class="avatar" style="border-radius:5px;margin:0"></div>
            <div class="text">
                <textarea class="cmt-textarea" placeholder="Ask a question or share your thoughts"></textarea>
                <button class="cmt-button" disabled data-id="{{this._id}}">
                    <span class="spinner" style="width:10px;height:10px"></span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                        style="width:14px;height:14px">
                        <path
                            d="M3.478 2.404a.75.75 0 0 0-.926.941l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.404Z" />
                    </svg>
                </button>
            </div>
        </div>
        <div class="commentList">
        </div>
    </div>
</div>
{{/each}}