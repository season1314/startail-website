<header class="header">
  <div class="container">
    <div class="nav">
      <a class="title">STARTAII</a>
      <nav class="menu">
        <a class="nav-item {{#if (eq active '/')}}active{{/if}}" href="/" id="home">Home</a>
        {{#each menu}}
        {{#each this}}
        <a class="nav-item  {{#if (eq ../../active @key)}}active{{/if}}" href="/category/{{@key}}">
          {{this}}
        </a>
        {{/each}}
        {{/each}}
        {{#if tag}}
        <a class="nav-item {{#if (eq active 'tag')}}active{{/if}}" href="/">{{tag.name}}</a>
        {{/if}}
      </nav>
    </div>
    <div class="element">
      {{#if search}}
      <div class="input-group" style="width:338px">
        <input type="text" class="input" placeholder="Keyword to search..." />
        <button class="button">Search</button>
      </div>
      {{/if}}
    </div>
  </div>
</header>
<style>
  .element {
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .input-group {
    width: inherit;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--input);
    border-radius: var(--radius);
    background-color: var(--background);
  }

  .input {
    border: none;
    outline: none;
    background: transparent;
    width: 100%;
    height: 28px;
    padding: 4px 8px 4px 12px;
  }

  .input-group:focus-within {
    border-color: var(--ring);
    box-shadow: 0 0 0 3px oklch(0.708 0 0 / 0.5);
  }


  .button {
    height: 6px;
    padding: 8px;
    font-size: 0.875rem;
    background-color: var(--background);
    border-radius: calc(var(--radius) - 5px);
    border: 1px solid var(--input);
    margin-right: 8px;
    color: var(--muted-foreground);
  }

  .button:hover {
    color: var(--accent-foreground);
    background-color: var(--accent);

  }

  .button:disabled {
    pointer-events: none;
    opacity: 0.5;
    cursor: not-allowed;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    border-bottom: 1px solid #e5e7eb;
    background-color: rgba(255, 255, 255, 0.95);
    height: 64px
  }

  header .container {
    display: flex;
    height: 4rem;
    align-items: center;
    padding-left: 10%;
    padding-right: 10%;
    width: 100%;
  }

  header .container .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 700px;
  }

  header .container .nav .title {
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.75rem;
  }

  header .container .nav .menu {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    margin-left: 1rem;
  }

  header .container .nav .menu .nav-item {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    height: 22px;
    cursor: pointer;
    border-color: transparent;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease;
    color: var(--muted-foreground);
  }

  header .container .nav .menu .nav-item:hover {
    color: var(--primary);
  }

  header .container .nav .menu .nav-item.active {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: var(--primary);
    border-bottom: 2px solid var(--primary);
    cursor: default;
    pointer-events: none;
    transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  header .container .nav .element {
    display: flex;
    align-items: center;
    width: 340px;
  }
</style>