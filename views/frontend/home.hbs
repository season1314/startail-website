<script src="/frontend/js/article.js"></script>
<script src="/frontend/js/loadBar.js"></script>
<div class="list">
    <div id="article-list">
        {{> frontend/article articleList=articleList}}
    </div>
    {{#if (isEmpty articleList)}}
    {{> frontend/empty title="Nothing here yet" des="Content will appear here once it becomes available."}}
    {{/if}}
    {{#if (lengthHigh articleList 5)}}
    <div class="skeleton">
        <div class="line short"></div>
        <div class="line"></div>
        <div class="line"></div>
        <div class="line short"></div>
        <div class="line"></div>
    </div>
    {{/if}}
    {{> frontend/footer}}
</div>
<script>
    let page = 1
    const path = window.location.pathname;
    const parts = path.split('/');
    const category = parts[parts.length - 1];

    window.addEventListener('beforeunload', function () {
        window.scrollTo(0, 0);
    });


    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            $('#article-list').find('.non-expend').css('display', 'flex').end()
                .find('.expend').css('display', 'none').end()
            $('#article-list').find('.svg').eq(0).css('display', 'block');
            $('#article-list').find('.svg').eq(1).css('display', 'none');
            $('#article-list').find('.commentList').empty().css('display', 'none')
            const $operation = $('#article-list').find('.article-operations .operation')
            $operation.eq(1).removeClass('active')
            $('#article-list').find('.comment').css('display', 'none')
        }
    });

    //Handle loadMore
    $(window).on('scroll', async function () {
        var $lastSkeleton = $('.skeleton').last();
        if ($lastSkeleton.length && $lastSkeleton.isInViewport(50)) {
            if (!$lastSkeleton.data('loading')) {
                $lastSkeleton.data('loading', true);
                const html = await fetchList(category)
                if (!html) {
                    $('.skeleton').remove()
                }
                $('#article-list').append(html)
                $lastSkeleton.data('loading', false)
            }
        }
    });


    $.fn.isInViewport = function (offset) {
        offset = offset || 0;
        if (!this.length) return false;
        var elementTop = this.offset().top;
        var elementBottom = elementTop + this.outerHeight();
        var viewportTop = $(window).scrollTop();
        var viewportBottom = viewportTop + $(window).height();
        return elementBottom > viewportTop + offset && elementTop < viewportBottom - offset;
    };

    async function fetchList(category) {
        page = page + 1
        const url = category ? `/category/${category}/list` : '/list'
        const res = await fetchData(url, 'GET', { page }, false)
        return await res.text();
    }
</script>
<style>
    .list {
        min-height: calc(100vh - 84px);
        width: 700px;
        background-color: rgba(255, 255, 255);
        border-radius: 2px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        padding: 0 1.5rem;
    }
</style>