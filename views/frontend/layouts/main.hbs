<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/frontend/css/style.css">
    <link rel="stylesheet" href="/frontend/css/article.css">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="/frontend/js/request.js"></script>
    <title></title>
</head>

<body class="loading">
    {{> frontend/header menu=categories active=menuActivated tag=tag search=search}}
    <div class="page">
        {{{body}}}
        {{#if sidebar}}
        <div class="sidebar">
            <div class="container">
                {{#if sidebar.login}}
                {{> frontend/login login=sidebar.login}}
                {{/if}}
            </div>
        </div>
        {{/if}}
    </div>
</body>
<style>
    .page {
        display: flex;
        padding-top: 10px;
        justify-content: center;
        font-family: sans-serif;
        width: 100%;
    }

    .sidebar {
        width: 300px;
        position: relative;
        margin-left: 10px;
    }

    .sidebar .container {
        position: fixed;
        top: 75px;
        width: 300px;
    }
</style>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        document.body.classList.remove('loading');
    });
</script>

</html>