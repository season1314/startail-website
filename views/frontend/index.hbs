<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/frontend/css/style.css">
  <title>{{title}}</title>
</head>
<body>
  {{> frontend/header}}
<div class="home">
  <div class="left-side">
    {{#each menu}}
    <li class="row">
      <object type="image/svg+xml" data="{{this.icon}}" style="width: 20px; height: 20px;"></object>
      <ul style="{{#if @first}}color:{{this.color}};font-weight:600;{{/if}}">{{this.title}}</ul>
    </li>
    {{#each this.context}}
     <li class="row2">{{this.title}}</li>
    {{/each}}
    {{/each}}
  </div>
  <div class="main">
    <div class="banner">
      <div class="row">
        <li class="item"></li>
        <li class="item"></li>
        <li class="item"></li>
      </div>
      <div class="row">
        <li class="item"></li>
        <li class="item"></li>
        <li class="item"></li>
      </div>
    </div>
  </div>
  <div class="side"></div>
</div>

</body>
</html>
