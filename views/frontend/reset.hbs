<link rel="stylesheet" href="/frontend/css/form.css">
<script src="/frontend/js/loadBar.js"></script>
<div>
    <!-- send form -->
    <div class="form" style="width:460px;margin-top:15%;display:{{#if (eq type 'mail')}}block{{else}}none{{/if}}"
        id="send">
        <a class="title">Reset password</a>
        <div class="des">Enter your email below and we'll send you a link to set a new password.</div>
        <div id="sendContainer">
            <form>
                <div class="column" id="email">
                    <label>Email</label>
                    <input type="text" placeholder="m@example.com"></input>
                    <a></a>
                </div>
            </form>
            <button class="dark" style="margin-top:30px" id="sendSubmit">
                <span class="spinner"></span>
                <a>Submit</a>
            </button>
            <div class="link">
                <a href="/">Login</a>
                <a href="#" onclick="window.location.replace('/auth/register')">Sign up</a>
            </div>
        </div>
        <div id="sendResult" style="display:none">
            <div class="resultBox">
            </div>
            <button class="dark" style="margin-top:30px" id="sendBack">
                <a>Back</a>
            </button>
        </div>
    </div>
    <!-- send form end  -->


    <!-- error form -->
    <div style="display:{{#if (eq type 'error')}}block{{else}}none{{/if}}" id="error">
        <div class="form" style="margin-top:15%">
            <a class="title" style="color:red">Error</a>
            <div class="des">{{messages}}</div>
            <button class="dark" style="margin-top:30px" id="resend">
                <a>Resend Email</a>
            </button>
        </div>
    </div>
    <!-- error form end -->


    <!-- step form -->
    <div class="form" style="width:460px;margin-top:15%;display:{{#if (eq type 'step')}}block{{else}}none{{/if}}"
        id="step">
        <a class="title">Complete reset password</a>
        <div class="des">Please complete the final steps to reset your password.</div>
        <div id="stepContainer">
            <form>
                <div class="column" id="password">
                    <label>Password</label>
                    <input type="password" placeholder="Enter Your Password"></input>
                    <a></a>
                </div>
                <div class="column" id="confirmPassword">
                    <label>Confirm Password</label>
                    <input type="password" placeholder="Re-Enter Your Password"></input>
                    <a></a>
                </div>
            </form>
            <button class="dark" style="margin-top:30px" id="reset">
                <span class="spinner"></span>
                <a>Submit</a>
            </button>
            <div class="link">
                <a href="/">Login</a>
                <a href="#" onclick="window.location.replace('/auth/reset)">Forget Password?</a>
            </div>
        </div>
        <div id="stepResult" style="display:none">
            <div class="resultBox">
            </div>
            <button class="dark" style="margin-top:30px" id="resend">
                <a>Resend Email</a>
            </button>
        </div>
    </div>
    <!-- step form end -->


    <!-- successful reset -->
    <div style="display:none" id="success">
        <div class="form" style="margin-top:15%">
            <a class="title" style="color:green">Reset password completed successfully.</a>
            <div class="des">You will be redirected to the login page in <a id="countdown">5</a> seconds.</div>
            <button class="dark" style="margin-top:30px" id="goHome">
                <a>Go to Login</a>
            </button>
        </div>
    </div>

    <!-- successful reset end -->

</div>
<script>

    //Handle submit
    $(document).on('click', '#sendSubmit', async function () {
        $(this).find('.spinner').addClass('is-show')
        $(this).find('a').css('display', 'none')
        $(this).prop('disabled', true)
        const $email = $('#email').find('input')
        const email = $email.val()
        $email.prop('disabled', true);

        if (!$email.val()) {
            $email.next('a').text('Email is required')
            $(this).find('.spinner').removeClass('is-show')
            $(this).find('a').css('display', 'block')
            $email.prop('disabled', false);
            $(this).prop('disabled', false)
            return
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test($email.val())) {
            $email.next('a').text('Invalid email format')
            $(this).find('.spinner').removeClass('is-show')
            $(this).find('a').css('display', 'block')
            $email.prop('disabled', false);
            $(this).prop('disabled', false)
            return
        }

        const result = await fetchData('/auth/email', 'GET', { type: 'reset', email })
        if (result.code == 2) {
            Object.entries(result.messages).forEach(([key, value]) => {
                $('#' + key).find('a').text(value[0])
            });
        } else if (result.code == 1) {
            $('#sendContainer').css('display', 'none')
            $('#sendResult').find('div').css('color', 'red').text(result.messages)
            $('#sendResult').css('display', 'block')
        } else if (result.code == 0) {
            $('#sendContainer').css('display', 'none')
            $('#sendResult').find('div').css('color', 'green').text(result.messages)
            $('#sendResult').css('display', 'block')
        }

        $(this).find('.spinner').removeClass('is-show')
        $(this).find('a').css('display', 'block')
        $email.prop('disabled', false);
        $(this).prop('disabled', false)
        return
    })


    //Handle send back
    $(document).on('click', '#sendBack', function () {
        $('#sendContainer').css('display', 'block')
        $('#sendResult').find('div').text('')
        $('#sendResult').css('display', 'none')
    })

    //Handle resend back
    $(document).on('click', '#resend', function () {
        $('#sendContainer').css('display', 'block')
        $('#sendResult').find('div').text('')
        $('#sendResult').css('display', 'none')
        $('#error').css('display', 'none')
        $('#step').css('display', 'none')
        $('#success').css('display', 'none')
        $('#send').css('display', 'block')
    })


    //Handle go home
    $(document).on('click', '#goHome', function () {
        window.location.replace("/");
    })



    //Handle reset button
    $(document).on('click', '#reset', async function () {
        $(this).find('.spinner').addClass('is-show')
        $(this).find('a').css('display', 'none')
        $(this).prop('disabled', true)
        $('#stepContainer').find('input').prop('disabled', true)
        const $password = $('#password').find('input')
        const $confirmPassword = $('#confirmPassword').find('input')
        const password = $password.val()
        const confirmPassword = $confirmPassword.val()
        const url = new URL(window.location.href);
        const code = url.searchParams.get('code');
        const res = await fetchData('/auth/reset/step', 'POST', { password, confirmPassword, code })
        if (res.code == 2) {
            Object.entries(res.messages).forEach(([key, value]) => { $('#' + key).find('a').text(value[0]) })
            $(this).find('.spinner').removeClass('is-show')
            $(this).find('a').css('display', 'block')
            $(this).prop('disabled', false)
        } else if (res.code == 1) {
            $('#stepContainer').css('display', 'none')
            $('#stepResult').css('display', 'block')
            $('#stepResult').find('div').css('color', 'red').text(res.messages)
        } else {
            $('#error').css('display', 'none')
            $('#step').css('display', 'none')
            $('#success').css('display', 'block')
            $('#send').css('display', 'none')
            let seconds = 5;
            const timer = setInterval(() => {
                seconds--;
                $('#countdown').text(seconds)
                if (seconds === 0) {
                    clearInterval(timer);
                    window.location.replace("/");
                }
            }, 1000);
        }
        $(this).find('.spinner').removeClass('is-show')
        $(this).find('a').css('display', 'block')
        $('#stepContainer').find('input').prop('disabled', false)
        $(this).prop('disabled', false)
        return
    })



    //Clear error info
    $('input').focus(function () {
        const $small = $(this).next('a');
        $small.text('');
    });


</script>
<style>
    .resultBox {
        margin-top: 20px;
        word-break: break-all;
        font-size: 14px;
        text-align: center;
    }
</style>