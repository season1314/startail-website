<script src="/frontend/js/article.js"></script>
<div class="list">
    <div id="article-list">
        {{> frontend/article articleList=articleList}}
    </div>
    {{#if (isEmpty articleList)}}
    {{> frontend/empty title="No results found" des="Try adjusting your search or filter to find what you're looking
    for."}}
    {{/if}}
    {{#if (lengthHigh articleList 5)}}
    <div class="skeleton">
        <div class="line short"></div>
        <div class="line"></div>
        <div class="line"></div>
        <div class="line short"></div>
        <div class="line"></div>
    </div>
    {{/if}}
    {{> frontend/footer}}
</div>
<script>
    let page = 1
    const queryString = window.location.search;
    const params = new URLSearchParams(queryString);
    const keyword = params.get('keyword') || "";
    const category = params.get('category') || "";

    window.addEventListener('beforeunload', function () {
        window.scrollTo(0, 0);
    });


    //Handle loadMore
    $(window).on('scroll', async function () {
        var $lastSkeleton = $('.skeleton').last();
        if ($lastSkeleton.length && $lastSkeleton.isInViewport(50)) {
            if (!$lastSkeleton.data('loading')) {
                $lastSkeleton.data('loading', true);
                const html = await fetchList(category)
                if (!html) {
                    $('.skeleton').remove()
                }
                $('#article-list').append(html)
                $lastSkeleton.data('loading', false)
            }
        }
    });


    $.fn.isInViewport = function (offset) {
        offset = offset || 0;
        if (!this.length) return false;
        var elementTop = this.offset().top;
        var elementBottom = elementTop + this.outerHeight();
        var viewportTop = $(window).scrollTop();
        var viewportBottom = viewportTop + $(window).height();
        return elementBottom > viewportTop + offset && elementTop < viewportBottom - offset;
    };

    async function fetchList(category) {
        page = page + 1
        const res = await fetchData('/search/list', 'GET', { page, keyword, category }, false)
        return await res.text();
    }
</script>
<style>
    .list {
        min-height: calc(100vh - 134px);
        width: 700px;
        background-color: rgba(255, 255, 255);
        border-radius: 2px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        padding: 0 1.5rem;
    }
</style>