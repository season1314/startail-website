<div class="list">
    <div id="article-list">
        {{> frontend/miniComment articleList=articleList user=user}}
    </div>
    {{#if (isEmpty articleList)}}
    {{> frontend/empty title="Nothing here yet" des="Content will appear here once it becomes available."}}
    {{/if}}
    {{#if (lengthHigh articleList 5)}}
    <div class="skeleton">
        <div class="line short"></div>
        <div class="line"></div>
        <div class="line"></div>
        <div class="line short"></div>
        <div class="line"></div>
    </div>
    {{/if}}
    {{> frontend/footer}}
</div>
<script>
    let page = 1
    window.addEventListener('beforeunload', function () {
        window.scrollTo(0, 0);
    });

    //Handle loadMore
    $(window).on('scroll', async function () {
        var $lastSkeleton = $('.skeleton').last();
        if ($lastSkeleton.length && $lastSkeleton.isInViewport(50)) {
            if (!$lastSkeleton.data('loading')) {
                $lastSkeleton.data('loading', true);
                const html = await fetchList()
                if (!html) {
                    $('.skeleton').remove()
                }
                $('#article-list').append(html)
                $lastSkeleton.data('loading', false)
            }
        }
    });


    $.fn.isInViewport = function (offset) {
        offset = offset || 0;
        if (!this.length) return false;
        var elementTop = this.offset().top;
        var elementBottom = elementTop + this.outerHeight();
        var viewportTop = $(window).scrollTop();
        var viewportBottom = viewportTop + $(window).height();
        return elementBottom > viewportTop + offset && elementTop < viewportBottom - offset;
    };


    //Handle mini-more
    $(document).on('click','.mini-more',function(){
        const id = $(this).data('id')
        window.location.href = '/article/page/' + id
    })

    async function fetchList() {
        page = page + 1
        const url = "comment/list"
        const res = await fetchData(url, 'GET', { page }, false)
        return await res.text();
    }

</script>
<style>
    .list {
        min-height: calc(100vh - 84px);
        width: 700px;
        background-color: rgba(255, 255, 255);
        border-radius: 2px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        padding: 0 1.5rem;
    }

    .commentNickname.comment {
        display: flex;
        height: 30px;

    }

    .commentNickname.comment .a {
        font-size: 12px;
        color: #6b7280;
        font-weight: normal;
    }
</style>