<script src="/frontend/js/article.js"></script>
<script src="/frontend/js/loadBar.js"></script>
<div class="list">
    <div id="article-list">
        {{> frontend/miniArticle articleList=articleList}}
    </div>
    {{#if (isEmpty articleList)}}
    {{> frontend/empty title="Nothing here yet" des="Content will appear here once it becomes available."}}
    {{/if}}
    {{#if (lengthHigh articleList 5)}}
    <div class="skeleton">
        <div class="line short"></div>
        <div class="line"></div>
        <div class="line"></div>
        <div class="line short"></div>
        <div class="line"></div>
    </div>
    {{/if}}
    {{> frontend/footer}}
</div>
<script>
    let page = 1
    const queryString = window.location.search;
    const urlParams = new URLSearchParams(queryString);
    const category = urlParams.get('category');

    window.addEventListener('beforeunload', function () {
        window.scrollTo(0, 0);
    });

    //Handle loadMore
    $(window).on('scroll', async function () {
        var $lastSkeleton = $('.skeleton').last();
        if ($lastSkeleton.length && $lastSkeleton.isInViewport(50)) {
            if (!$lastSkeleton.data('loading')) {
                $lastSkeleton.data('loading', true);
                const html = await fetchList(category)
                if (!html) {
                    $('.skeleton').remove()
                }
                $('#article-list').append(html)
                $lastSkeleton.data('loading', false)
            }
        }
    });

    //Handle filter
    $(document).on('click', '.filter-nav-item', function () {
        const category = $(this).data('category')
        const url = '/auth/favorite' + category ? `?category=${category}` : ""
        window.location.replace(url)
    })


    $.fn.isInViewport = function (offset) {
        offset = offset || 0;
        if (!this.length) return false;
        var elementTop = this.offset().top;
        var elementBottom = elementTop + this.outerHeight();
        var viewportTop = $(window).scrollTop();
        var viewportBottom = viewportTop + $(window).height();
        return elementBottom > viewportTop + offset && elementTop < viewportBottom - offset;
    };

    async function fetchList(category) {
        page = page + 1
        const url = "/auth/favorite/list"
        const res = await fetchData(url, 'GET', { page, category }, false)
        return await res.text();
    }
</script>
<style>
    .list {
        min-height: calc(100vh - 84px);
        width: 700px;
        background-color: rgba(255, 255, 255);
        border-radius: 2px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        padding: 0 1.5rem;
    }
</style>